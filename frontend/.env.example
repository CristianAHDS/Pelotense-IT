# URL base da API (backend). Deixe vazio para usar o proxy local de dev (/api).
# Exemplo para backend na mesma rede local:
# VITE_API_URL=http://192.168.1.100:3001/api
VITE_API_URL=

# URL do servidor Socket.IO (default: derivado de VITE_API_URL ou hostname:3001).
# VITE_SOCKET_URL=http://192.168.1.100:3001
VITE_SOCKET_URL=
